// This file was generated from a template. Edit it to match your keyboard.
// See https://zmk.dev/docs/development/hardware-integration/new-shield for more instructions.

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q &kp W &kp E &kp R &kp T &kp Y   &kp U &kp I &kp O &kp P &kp LBKT &kp RBKT
                &kp A &kp S &kp D &kp F &kp G &kp H   &kp J &kp K &kp L &kp SEMI &kp SQT &kp ENTER
                &kp Z &kp X &kp C &kp V &kp B &kp N   &kp M &kp COMMA &kp DOT &kp SLASH &kp LEFT &kp DOWN
                &kp LCTRL &kp LALT &kp LSHIFT &kp LGUI &kp SPACE &kp TAB &kp BSPC &kp ESC &kp RIGHT &kp UP &kp RALT &kp RSHIFT
            >;
        };
    };
};
