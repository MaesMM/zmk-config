#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                &kp Q       &kp W       &kp E       &kp R       &kp T       &kp Y
                &kp U       &kp I       &kp O       &kp P       &kp LBKT    &kp RBKT
                &kp A       &kp S       &kp D       &kp F       &kp G       &kp H
                &kp J       &kp K       &kp L       &kp SEMI     &kp SQT     &kp ENTER
                &kp Z       &kp X       &kp C       &kp V       &kp B       &kp N
                &kp M       &kp COMMA    &kp DOT     &kp SLASH    &kp LEFT    &kp DOWN
                &kp LCTRL   &kp LALT     &kp LSHIFT   &kp LGUI     &kp SPACE   &mo 1
                &kp BSPC    &kp ESC      &kp RIGHT    &kp UP       &kp RALT    &kp RSHIFT
            >;
        };

        bt_layer {
            bindings = <
                &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4 &bt BT_CLR
                &bt BT_NXT   &bt BT_PRV   &bt BT_CLR_ALL &sys_reset &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
                &trans       &trans       &trans        &trans      &trans &trans
            >;
        };
    };
};
